/* ═══════════════════════════════════════════════
   Feature: Add Student
═══════════════════════════════════════════════ */
void addStudent(struct StudentDB *db) {
    if (db->count >= db->capacity) growDB(db);  /* auto-grow */

    struct Student *s = &db->data[db->count];

    /* Name */
    clearInputBuffer();
    printf("   Enter student name: ");
    fgets(s->name, sizeof(s->name), stdin);
    s->name[strcspn(s->name, "\n")] = '\0';
    if (strlen(s->name) == 0) {
        printf("   [!] Name cannot be empty.\n"); return;
    }

    /* Roll Number — validated and unique */
    int roll;
    while (1) {
        printf("   Enter roll number: ");
        if (scanf("%d", &roll) != 1) {
            printf("   [!] Invalid input.\n"); clearInputBuffer(); continue;
        }
        if (roll <= 0) { printf("   [!] Must be positive.\n"); continue; }
        if (rollNumberExists(db, roll, -1)) {
            printf("   [!] Roll %d already exists.\n", roll); continue;
        }
        break;
    }
    s->rollNumber = roll;

    /* Subject marks — each validated 0-100 */
    for (int i = 0; i < MAX_SUBJECTS; i++)
        s->marks[i] = readValidMark(SUBJECT_NAMES[i]);

    db->count++;
    assignRanks(db->data, db->count);
    printf("   [OK] Student added! (Total: %d, Capacity: %d)\n", db->count, db->capacity);
}

/* ═══════════════════════════════════════════════
   Feature: View All Students (uses recursiveDisplay)
═══════════════════════════════════════════════ */
void viewStudents(struct StudentDB *db) {
    if (db->count == 0) {
        printf("   [i] No students to display.\n"); return;
    }
    printf("\n  Displaying %d student(s):\n", db->count);
    recursiveDisplay(db->data, 0, db->count);
}

/* ═══════════════════════════════════════════════
   Feature: Update Student
═══════════════════════════════════════════════ */
void updateStudent(struct StudentDB *db) {
    if (db->count == 0) {
        printf("   [i] No students to update.\n"); return;
    }
    int roll;
    printf("   Enter roll number to update: ");
    if (scanf("%d", &roll) != 1) { clearInputBuffer(); return; }

    int idx = -1;
    for (int i = 0; i < db->count; i++)
        if (db->data[i].rollNumber == roll) { idx = i; break; }

    if (idx == -1) {
        printf("   [!] Roll %d not found.\n", roll); return;
    }

    struct Student *s = &db->data[idx];
    printf("   Updating: %s\n", s->name);

    clearInputBuffer();
    printf("   New name: ");
    fgets(s->name, sizeof(s->name), stdin);
    s->name[strcspn(s->name, "\n")] = '\0';
    if (strlen(s->name) == 0) {
        printf("   [!] Name cannot be empty. Update cancelled.\n"); return;
    }

    int newRoll;
    while (1) {
        printf("   New roll number: ");
        if (scanf("%d", &newRoll) != 1) { clearInputBuffer(); continue; }
        if (newRoll <= 0) { printf("   [!] Must be positive.\n"); continue; }
        if (newRoll != roll && rollNumberExists(db, newRoll, idx)) {
            printf("   [!] Roll %d taken by another student.\n", newRoll); continue;
        }
        break;
    }
    s->rollNumber = newRoll;

    for (int j = 0; j < MAX_SUBJECTS; j++)
        s->marks[j] = readValidMark(SUBJECT_NAMES[j]);

    assignRanks(db->data, db->count);
    printf("   [OK] Student updated successfully!\n");
}

/* ═══════════════════════════════════════════════
   Feature: Delete Student
═══════════════════════════════════════════════ */
void deleteStudent(struct StudentDB *db) {
    if (db->count == 0) {
        printf("   [i] No students to delete.\n"); return;
    }
    int roll;
    printf("   Enter roll number to delete: ");
    if (scanf("%d", &roll) != 1) { clearInputBuffer(); return; }

    for (int i = 0; i < db->count; i++) {
        if (db->data[i].rollNumber == roll) {
            char confirm;
            printf("   Delete '%s'? (y/n): ", db->data[i].name);
            clearInputBuffer();
            scanf("%c", &confirm);
            if (confirm != 'y' && confirm != 'Y') {
                printf("   Deletion cancelled.\n"); return;
            }
            for (int j = i; j < db->count - 1; j++)
                db->data[j] = db->data[j + 1];
            db->count--;
            assignRanks(db->data, db->count);
            printf("   [OK] Deleted. (%d remaining)\n", db->count);
            return;
        }
    }
    printf("   [!] Roll %d not found.\n", roll);
}

/* ═══════════════════════════════════════════════
   Feature: Search Student
   -- Roll : sort by roll then recursiveBinarySearch
   -- Name : recursiveNameSearch (substring, case-insensitive)
═══════════════════════════════════════════════ */
void searchStudent(struct StudentDB *db) {
    if (db->count == 0) {
        printf("   [i] No students to search.\n"); return;
    }
    printf("\n  Search by:\n");
    printf("    1. Roll Number  (Recursive Binary Search)\n");
    printf("    2. Name         (Recursive Linear Search)\n");
    printf("  Choice: ");

    int choice;
    if (scanf("%d", &choice) != 1) { clearInputBuffer(); return; }

    if (choice == 1) {
        /* Binary search requires sorted array */
        recursiveQuickSortByRoll(db->data, 0, db->count - 1);
        assignRanks(db->data, db->count);

        int roll;
        printf("   Enter roll number: ");
        if (scanf("%d", &roll) != 1) { clearInputBuffer(); return; }

        int idx = recursiveBinarySearch(db->data, 0, db->count - 1, roll);
        if (idx == -1)
            printf("   [!] Roll %d not found.\n", roll);
        else {
            printf("   [OK] Found via Recursive Binary Search!\n");
            recursiveDisplay(db->data, idx, idx + 1);
        }

    } else if (choice == 2) {
        clearInputBuffer();
        char query[50];
        printf("   Enter name (or part of it): ");
        fgets(query, sizeof(query), stdin);
        query[strcspn(query, "\n")] = '\0';

        int idx = recursiveNameSearch(db->data, 0, db->count, query);
        if (idx == -1)
            printf("   [!] No student found matching '%s'.\n", query);
        else {
            printf("   [OK] Found via Recursive Linear Search!\n");
            recursiveDisplay(db->data, idx, idx + 1);
        }
    } else {
        printf("   [!] Invalid option.\n");
    }
}

/* ═══════════════════════════════════════════════
   Feature: Sort Students (Recursive QuickSort)
═══════════════════════════════════════════════ */
void sortStudents(struct StudentDB *db) {
    if (db->count < 2) {
        printf("   [i] Need at least 2 students to sort.\n"); return;
    }
    printf("\n  Sort by:\n");
    printf("    1. Total Marks  (Descending) -- Recursive QuickSort\n");
    printf("    2. Roll Number  (Ascending)  -- Recursive QuickSort\n");
    printf("  Choice: ");

    int choice;
    if (scanf("%d", &choice) != 1) { clearInputBuffer(); return; }

    if (choice == 1) {
        recursiveQuickSortByMarks(db->data, 0, db->count - 1);
        assignRanks(db->data, db->count);
        printf("   [OK] Sorted by total marks (highest first).\n");
    } else if (choice == 2) {
        recursiveQuickSortByRoll(db->data, 0, db->count - 1);
        assignRanks(db->data, db->count);
        printf("   [OK] Sorted by roll number (ascending).\n");
    } else {
        printf("   [!] Invalid option.\n");
    }
}

/* ═══════════════════════════════════════════════
   Feature: Class Statistics
   Uses: recursiveClassSum, recursiveFindMax/Min,
         recursivePassFail, recursiveGradeDist
═══════════════════════════════════════════════ */
void classStatistics(struct StudentDB *db) {
    if (db->count == 0) {
        printf("   [i] No data available.\n"); return;
    }

    float totalSum = recursiveClassSum(db->data, 0, db->count);
    float classAvg = totalSum / db->count;
    float avgPct   = (classAvg / (MAX_SUBJECTS * MAX_MARKS)) * 100.0f;
    char  avgGrade[10]; getGrade(avgPct, avgGrade);

    int topIdx = recursiveFindMax(db->data, 1, db->count, 0);
    int lowIdx = recursiveFindMin(db->data, 1, db->count, 0);

    int pass = 0, fail = 0;
    recursivePassFail(db->data, 0, db->count, &pass, &fail);

    int aPlus = 0, a = 0, b = 0, c = 0, d = 0, f = 0;
    recursiveGradeDist(db->data, 0, db->count, &aPlus, &a, &b, &c, &d, &f);

    printf("\n  +=======================================+\n");
    printf("  |          CLASS STATISTICS             |\n");
    printf("  +=======================================+\n");
    printf("  |  Total Students : %-20d |\n", db->count);
    printf("  |  Class Average  : %-7.2f / 500         |\n", classAvg);
    printf("  |  Avg Percentage : %-7.2f%%              |\n", avgPct);
    printf("  |  Class Grade    : %-20s |\n", avgGrade);
    printf("  +---------------------------------------+\n");
    printf("  |  [TOP] %-31s |\n", db->data[topIdx].name);
    printf("  |        Total: %-7.2f / 500             |\n",
           recursiveTotalMarks(db->data[topIdx].marks, 0));
    printf("  +---------------------------------------+\n");
    printf("  |  [LOW] %-31s |\n", db->data[lowIdx].name);
    printf("  |        Total: %-7.2f / 500             |\n",
           recursiveTotalMarks(db->data[lowIdx].marks, 0));
    printf("  +---------------------------------------+\n");
    printf("  |  Passed         : %-20d |\n", pass);
    printf("  |  Failed         : %-20d |\n", fail);
    printf("  +---------------------------------------+\n");
    printf("  |  Grade Distribution:                  |\n");
    printf("  |   A+ (>=90%%)   : %-20d |\n", aPlus);
    printf("  |   A  (>=80%%)   : %-20d |\n", a);
    printf("  |   B  (>=70%%)   : %-20d |\n", b);
    printf("  |   C  (>=60%%)   : %-20d |\n", c);
    printf("  |   D  (>=50%%)   : %-20d |\n", d);
    printf("  |   F  (<50%%)    : %-20d |\n", f);
    printf("  +=======================================+\n");
}

/* ═══════════════════════════════════════════════
   Feature: Subject-wise Analysis
   Uses: recursiveSubjectSum
═══════════════════════════════════════════════ */
void subjectAnalysis(struct StudentDB *db) {
    if (db->count == 0) {
        printf("   [i] No data for analysis.\n"); return;
    }
    printf("\n  +=============================================+\n");
    printf("  |         SUBJECT-WISE ANALYSIS               |\n");
    printf("  +=============================================+\n");

    for (int s = 0; s < MAX_SUBJECTS; s++) {
        float sum = recursiveSubjectSum(db->data, 0, db->count, s);
        float avg = sum / db->count;

        int maxIdx = 0, minIdx = 0;
        for (int i = 1; i < db->count; i++) {
            if (db->data[i].marks[s] > db->data[maxIdx].marks[s]) maxIdx = i;
            if (db->data[i].marks[s] < db->data[minIdx].marks[s]) minIdx = i;
        }

        printf("  |  %-14s                              |\n", SUBJECT_NAMES[s]);
        printf("  |   Class Avg : %-6.2f                        |\n", avg);
        printf("  |   Highest   : %-6.2f  (%-20s) |\n",
               db->data[maxIdx].marks[s], db->data[maxIdx].name);
        printf("  |   Lowest    : %-6.2f  (%-20s) |\n",
               db->data[minIdx].marks[s], db->data[minIdx].name);
        if (s < MAX_SUBJECTS - 1)
            printf("  +---------------------------------------------+\n");
    }
    printf("  +=============================================+\n");
}

