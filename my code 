int main(void) {
    printf("\n  +==========================================+\n");
    printf("  |      GRADE MANAGEMENT SYSTEM  v2.0      |\n");
    printf("  |   Dynamic Memory  |  Recursive Logic    |\n");
    printf("  +==========================================+\n");

    struct StudentDB db;
    initDB(&db);
    loadFromFile(&db);  /* auto-load saved data on startup */

    int choice;
    while (1) {
        displayMenu(db.count, db.capacity);
        printf("  Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("  [!] Invalid input. Enter a number 0-10.\n");
            clearInputBuffer();
            continue;
        }

        switch (choice) {
            case 1:  addStudent(&db);       break;
            case 2:  viewStudents(&db);     break;
            case 3:  updateStudent(&db);    break;
            case 4:  deleteStudent(&db);    break;
            case 5:  searchStudent(&db);    break;
            case 6:  sortStudents(&db);     break;
            case 7:  classStatistics(&db);  break;
            case 8:  subjectAnalysis(&db);  break;
            case 9:  saveToFile(&db);       break;
            case 10: loadFromFile(&db);     break;
            case 0:
                saveToFile(&db);
                freeDB(&db);
                printf("\n  Data auto-saved. Goodbye!\n\n");
                return 0;
            default:
                printf("  [!] Invalid choice. Enter 0-10.\n");
        }
    }
}
