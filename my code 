#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

/* ═══════════════════════════════════════════════
   Constants
═══════════════════════════════════════════════ */
#define MAX_SUBJECTS      5
#define MAX_MARKS         100.0f
#define INITIAL_CAPACITY  10
#define SAVE_FILE         "students.dat"

const char *SUBJECT_NAMES[MAX_SUBJECTS] = {
    "Mathematics",
    "Physics",
    "Chemistry",
    "English",
    "Computer Sci"
};

/* ═══════════════════════════════════════════════
   Data Structures
═══════════════════════════════════════════════ */
struct Student {
    char  name[50];
    int   rollNumber;
    float marks[MAX_SUBJECTS];
    int   rank;
};

/* Dynamic array — grows automatically with realloc */
struct StudentDB {
    struct Student *data;
    int             count;
    int             capacity;
};

/* ═══════════════════════════════════════════════
   Dynamic Array Helpers
═══════════════════════════════════════════════ */
void initDB(struct StudentDB *db) {
    db->capacity = INITIAL_CAPACITY;
    db->count    = 0;
    db->data     = (struct Student *)malloc(db->capacity * sizeof(struct Student));
    if (!db->data) { fprintf(stderr, "Fatal: malloc failed\n"); exit(1); }
}

void growDB(struct StudentDB *db) {
    db->capacity *= 2;
    db->data = (struct Student *)realloc(db->data, db->capacity * sizeof(struct Student));
    if (!db->data) { fprintf(stderr, "Fatal: realloc failed\n"); exit(1); }
}

void freeDB(struct StudentDB *db) {
    free(db->data);
    db->data     = NULL;
    db->count    = 0;
    db->capacity = 0;
}

/* ═══════════════════════════════════════════════
   Utility Helpers
═══════════════════════════════════════════════ */
void clearInputBuffer(void) {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

/* Returns 1 if rollNumber already exists, skipping index excludeIdx (-1 = skip none) */
int rollNumberExists(struct StudentDB *db, int rollNumber, int excludeIdx) {
    for (int i = 0; i < db->count; i++) {
        if (i == excludeIdx) continue;
        if (db->data[i].rollNumber == rollNumber) return 1;
    }
    return 0;
}

void getGrade(float percentage, char *grade) {
    if      (percentage >= 90) strcpy(grade, "A+");
    else if (percentage >= 80) strcpy(grade, "A");
    else if (percentage >= 70) strcpy(grade, "B");
    else if (percentage >= 60) strcpy(grade, "C");
    else if (percentage >= 50) strcpy(grade, "D");
    else                       strcpy(grade, "F");
}

/* ═══════════════════════════════════════════════
   RECURSIVE FUNCTIONS
═══════════════════════════════════════════════ */

/*
 * 1. Recursive Total Marks
 *    Adds marks[index] + marks[index+1] + ... recursively.
 *    Base case: when index reaches MAX_SUBJECTS, return 0.
 */
float recursiveTotalMarks(float *marks, int index) {
    if (index == MAX_SUBJECTS) return 0.0f;
    return marks[index] + recursiveTotalMarks(marks, index + 1);
}

/*
 * 2. Recursive Display
 *    Prints one student card then calls itself for the next index.
 *    Base case: when index reaches count, stop.
 */
void recursiveDisplay(struct Student *students, int index, int count) {
    if (index >= count) return;

    float total      = recursiveTotalMarks(students[index].marks, 0);
    float percentage = (total / (MAX_SUBJECTS * MAX_MARKS)) * 100.0f;
    char  grade[10];
    getGrade(percentage, grade);

    printf("\n +------------------------------------------------+\n");
    printf(" | Rank #%-3d   %-36s|\n", students[index].rank, students[index].name);
    printf(" +------------------------------------------------+\n");
    printf(" | Roll Number  : %-31d |\n", students[index].rollNumber);

    for (int j = 0; j < MAX_SUBJECTS; j++) {
        printf(" |  %-14s : %-31.2f |\n", SUBJECT_NAMES[j], students[index].marks[j]);
    }

    printf(" +------------------------------------------------+\n");
    printf(" | Total Marks  : %-7.2f / 500                  |\n", total);
    printf(" | Percentage   : %-7.2f%%                       |\n", percentage);
    printf(" | Grade        : %-7s                        |\n", grade);
    printf(" +------------------------------------------------+\n");

    /* recursive call for next student */
    recursiveDisplay(students, index + 1, count);
}

/*
 * 3. Recursive Binary Search (by roll number)
 *    Array MUST be sorted by rollNumber before calling.
 *    Returns the index of the match, or -1 if not found.
 */
int recursiveBinarySearch(struct Student *students, int low, int high, int roll) {
    if (low > high) return -1;                          /* base: not found */
    int mid = low + (high - low) / 2;
    if (students[mid].rollNumber == roll) return mid;   /* base: found     */
    if (students[mid].rollNumber < roll)
        return recursiveBinarySearch(students, mid + 1, high, roll);
    return     recursiveBinarySearch(students, low,    mid - 1, roll);
}

/*
 * 4. Recursive Linear Search (by name, case-insensitive substring)
 *    Returns index of first match, or -1.
 */
int recursiveNameSearch(struct Student *students, int index, int count, const char *query) {
    if (index == count) return -1;                      /* base: not found */

    char haystack[50], needle[50];
    strncpy(haystack, students[index].name, 49); haystack[49] = '\0';
    strncpy(needle,   query,               49); needle[49]   = '\0';
    for (int i = 0; haystack[i]; i++) haystack[i] = (char)tolower((unsigned char)haystack[i]);
    for (int i = 0; needle[i];   i++) needle[i]   = (char)tolower((unsigned char)needle[i]);

    if (strstr(haystack, needle) != NULL) return index; /* base: found    */
    return recursiveNameSearch(students, index + 1, count, query);
}

/*
 * 5. Recursive Maximum Finder (highest total marks)
 *    Compares current index against running maxIdx.
 */
int recursiveFindMax(struct Student *students, int index, int count, int maxIdx) {
    if (index == count) return maxIdx;                  /* base case */
    float curTotal = recursiveTotalMarks(students[index].marks, 0);
    float maxTotal = recursiveTotalMarks(students[maxIdx].marks, 0);
    int   newMax   = (curTotal > maxTotal) ? index : maxIdx;
    return recursiveFindMax(students, index + 1, count, newMax);
}

/*
 * 6. Recursive Minimum Finder (lowest total marks)
 */
int recursiveFindMin(struct Student *students, int index, int count, int minIdx) {
    if (index == count) return minIdx;                  /* base case */
    float curTotal = recursiveTotalMarks(students[index].marks, 0);
    float minTotal = recursiveTotalMarks(students[minIdx].marks, 0);
    int   newMin   = (curTotal < minTotal) ? index : minIdx;
    return recursiveFindMin(students, index + 1, count, newMin);
}

/*
 * 7. Recursive Class Sum (sum of all students' total marks)
 */
float recursiveClassSum(struct Student *students, int index, int count) {
    if (index == count) return 0.0f;                    /* base case */
    return recursiveTotalMarks(students[index].marks, 0)
           + recursiveClassSum(students, index + 1, count);
}

/*
 * 8. Recursive Pass / Fail Counter (pass threshold = 50%)
 */
void recursivePassFail(struct Student *students, int index, int count, int *pass, int *fail) {
    if (index == count) return;                         /* base case */
    float pct = (recursiveTotalMarks(students[index].marks, 0)
                 / (MAX_SUBJECTS * MAX_MARKS)) * 100.0f;
    if (pct >= 50.0f) (*pass)++; else (*fail)++;
    recursivePassFail(students, index + 1, count, pass, fail);
}

/*
 * 9. Recursive Subject Average Sum (across all students for one subject)
 */
float recursiveSubjectSum(struct Student *students, int index, int count, int subjectIdx) {
    if (index == count) return 0.0f;                    /* base case */
    return students[index].marks[subjectIdx]
           + recursiveSubjectSum(students, index + 1, count, subjectIdx);
}

/*
 * 10. Recursive QuickSort — descending by total marks
 *     Partition + two recursive calls on sub-arrays.
 */
void swapStudents(struct Student *a, struct Student *b) {
    struct Student tmp = *a; *a = *b; *b = tmp;
}

int partitionByMarks(struct Student *students, int low, int high) {
    float pivot = recursiveTotalMarks(students[high].marks, 0);
    int   i     = low - 1;
    for (int j = low; j < high; j++) {
        if (recursiveTotalMarks(students[j].marks, 0) > pivot) {
            i++;
            swapStudents(&students[i], &students[j]);
        }
    }
    swapStudents(&students[i + 1], &students[high]);
    return i + 1;
}

void recursiveQuickSortByMarks(struct Student *students, int low, int high) {
    if (low >= high) return;                            /* base case */
    int pi = partitionByMarks(students, low, high);
    recursiveQuickSortByMarks(students, low,    pi - 1);
    recursiveQuickSortByMarks(students, pi + 1, high);
}

/*
 * 11. Recursive QuickSort — ascending by roll number
 */
int partitionByRoll(struct Student *students, int low, int high) {
    int pivot = students[high].rollNumber;
    int i     = low - 1;
    for (int j = low; j < high; j++) {
        if (students[j].rollNumber < pivot) {
            i++;
            swapStudents(&students[i], &students[j]);
        }
    }
    swapStudents(&students[i + 1], &students[high]);
    return i + 1;
}

void recursiveQuickSortByRoll(struct Student *students, int low, int high) {
    if (low >= high) return;                            /* base case */
    int pi = partitionByRoll(students, low, high);
    recursiveQuickSortByRoll(students, low,    pi - 1);
    recursiveQuickSortByRoll(students, pi + 1, high);
}

/*
 * 12. Recursive Grade Distribution Counter
 *     Counts how many students fall into each grade bucket.
 */
void recursiveGradeDist(struct Student *students, int index, int count,
                        int *aPlus, int *a, int *b, int *c, int *d, int *f) {
    if (index == count) return;                         /* base case */
    float pct = (recursiveTotalMarks(students[index].marks, 0)
                 / (MAX_SUBJECTS * MAX_MARKS)) * 100.0f;
    char g[10]; getGrade(pct, g);
    if      (strcmp(g, "A+") == 0) (*aPlus)++;
    else if (strcmp(g, "A")  == 0) (*a)++;
    else if (strcmp(g, "B")  == 0) (*b)++;
    else if (strcmp(g, "C")  == 0) (*c)++;
    else if (strcmp(g, "D")  == 0) (*d)++;
    else                           (*f)++;
    recursiveGradeDist(students, index + 1, count, aPlus, a, b, c, d, f);
}

/* ═══════════════════════════════════════════════
   Rank Assignment
═══════════════════════════════════════════════ */
void assignRanks(struct Student *students, int count) {
    for (int i = 0; i < count; i++) {
        float myTotal = recursiveTotalMarks(students[i].marks, 0);
        int rank = 1;
        for (int j = 0; j < count; j++) {
            if (i == j) continue;
            if (recursiveTotalMarks(students[j].marks, 0) > myTotal) rank++;
        }
        students[i].rank = rank;
    }
}

/* ═══════════════════════════════════════════════
   File Persistence (Binary)
═══════════════════════════════════════════════ */
void saveToFile(struct StudentDB *db) {
    FILE *fp = fopen(SAVE_FILE, "wb");
    if (!fp) { printf("   [!] Could not save to file.\n"); return; }
    fwrite(&db->count, sizeof(int),            1,         fp);
    fwrite(db->data,   sizeof(struct Student), db->count, fp);
    fclose(fp);
    printf("   [OK] Data saved to '%s'.\n", SAVE_FILE);
}

void loadFromFile(struct StudentDB *db) {
    FILE *fp = fopen(SAVE_FILE, "rb");
    if (!fp) { printf("   [i] No save file found. Starting fresh.\n"); return; }
    int count = 0;
    fread(&count, sizeof(int), 1, fp);
    while (db->capacity < count) growDB(db);
    fread(db->data, sizeof(struct Student), count, fp);
    db->count = count;
    fclose(fp);
    assignRanks(db->data, db->count);
    printf("   [OK] Loaded %d student(s) from '%s'.\n", count, SAVE_FILE);
}

/* ═══════════════════════════════════════════════
   Input Helper
═══════════════════════════════════════════════ */
float readValidMark(const char *subjectName) {
    float mark;
    while (1) {
        printf("   Enter marks for %-14s (0-100): ", subjectName);
        if (scanf("%f", &mark) == 1 && mark >= 0.0f && mark <= MAX_MARKS)
            return mark;
        printf("   [!] Invalid! Must be 0-100.\n");
        clearInputBuffer();
    }
}

